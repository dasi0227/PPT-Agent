{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ppt-agent.local/schemas/asset-manifest.schema.json",
  "title": "AssetManifest",
  "description": "个人仓库统一资产清单：统一信封 + 按 kind 区分的载荷约束。4 类：layout/component/theme/fx。",
  "type": "object",
  "required": ["name", "version", "kind", "description", "assets"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "资产名（小写短横线）"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "语义化版本"
    },
    "kind": {
      "type": "string",
      "enum": ["layout", "component", "theme", "fx"],
      "description": "资产类型"
    },
    "source": {
      "type": "string",
      "enum": ["preset", "user"],
      "default": "user",
      "description": "preset=出厂预置；user=用户新增"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "一句话用途，供 AI 语义检索匹配"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "preview": {
      "type": "string",
      "description": "预览图/示例引用（可选）"
    },
    "mount": {
      "type": "object",
      "description": "挂载约定（layout/component/fx 用；theme 不需要）",
      "additionalProperties": false,
      "required": ["position"],
      "properties": {
        "target": {
          "type": "string",
          "description": "挂载目标：CSS 选择器或语义位（如 'slide-root'、'.cover'）。缺省为 slide 根"
        },
        "position": {
          "type": "string",
          "enum": ["append", "prepend", "replace", "wrap"]
        }
      }
    },
    "params": {
      "type": "object",
      "description": "参数 schema（component/fx 用）。每个参数须含 type 与 default",
      "additionalProperties": {
        "type": "object",
        "required": ["type", "default"],
        "additionalProperties": false,
        "properties": {
          "type": { "type": "string", "enum": ["string", "number", "boolean", "color", "enum"] },
          "default": {},
          "enum": { "type": "array" },
          "description": { "type": "string" }
        }
      }
    },
    "assets": {
      "type": "object",
      "description": "载荷文件清单（相对资产目录）",
      "additionalProperties": false,
      "properties": {
        "html": { "type": "string", "description": "layout/component 的 html 载荷" },
        "css": { "type": "string" },
        "js": { "type": "string", "description": "fx 的特效脚本" },
        "tokens": { "type": "string", "description": "theme 的 token 全集载荷（tokens.css）" }
      }
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tokens": { "type": "array", "items": { "type": "string" }, "description": "依赖的 design token 名" },
        "cdn": { "type": "array", "items": { "type": "string" }, "description": "可选 CDN 资源（MVP 谨慎使用）" }
      }
    },
    "cleanup": {
      "type": "boolean",
      "default": false,
      "description": "fx 资产是否需要页离开清理（RAF/监听）；fx 建议 true"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "fx" } } },
      "then": {
        "required": ["mount"],
        "properties": { "assets": { "required": ["js"] } }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "theme" } } },
      "then": {
        "properties": { "assets": { "required": ["tokens"] } }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "layout" } } },
      "then": {
        "required": ["mount"],
        "properties": { "assets": { "required": ["html"] } }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "component" } } },
      "then": {
        "required": ["mount"],
        "properties": { "assets": { "required": ["html"] } }
      }
    }
  ]
}
