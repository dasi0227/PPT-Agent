# Backend runtime environment.
# Copy this file to backend/.env for local development.

# HTTP listen address.
WORK_ADDR=127.0.0.1:8787

# Runtime workspace root. The SQLite database is stored at:
# $WORK_ROOT/db/ppt.db
WORK_ROOT=$HOME/.dasi/ppt

# LLM profiles are configured in YAML, not in .env.
# When running from backend/ directly, point to the root config.yaml.
LLM_CONFIG_PATH=../config.yaml
