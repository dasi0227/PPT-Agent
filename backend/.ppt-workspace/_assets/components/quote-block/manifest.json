{
  "name": "quote-block",
  "version": "1.0.0",
  "kind": "component",
  "source": "preset",
  "description": "引用块：突出引文与出处",
  "tags": ["quote", "citation"],
  "mount": { "target": ".slide-content", "position": "append" },
