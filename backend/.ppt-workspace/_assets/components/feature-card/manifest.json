{
  "name": "feature-card",
  "version": "1.0.0",
  "kind": "component",
  "source": "preset",
  "description": "特性卡片：标题 + 描述的功能点卡片",
  "tags": ["feature", "card"],
  "mount": { "target": ".slide-content", "position": "append" },
  "params": {
    "title": { "type": "string", "default": "特性标题", "description": "卡片标题" },
    "desc": { "type": "string", "default": "特性描述", "description": "卡片描述" }
  },
  "assets": { "html": "template.html", "css": "style.css" }
}
