{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ppt-agent.local/schemas/slide-spec.schema.json",
  "title": "PPT Slide Spec",
  "description": "One slide's semantic role, core message, content hierarchy, visual intent, and speaker notes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "revision",
    "project_id",
    "slide_id",
    "source_outline_revision",
    "section_id",
    "role",
    "title",
    "key_message",
    "content",
    "visual_intent",
    "speaker_notes",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "3.0",
      "x-runtime-managed": true
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "x-runtime-managed": true
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "x-runtime-managed": true
    },
    "slide_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
      "x-runtime-managed": true
    },
    "source_outline_revision": {
      "type": "integer",
      "minimum": 1,
      "x-runtime-managed": true
    },
    "section_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "subsection_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "role": {
      "type": "string",
      "enum": [
        "cover",
        "agenda",
        "section-divider",
        "context",
        "problem",
        "insight",
        "evidence",
        "comparison",
        "solution",
        "process",
        "case-study",
        "summary",
        "cta",
        "closing"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "key_message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "points"],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1600
        },
        "points": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 360
          }
        }
      }
    },
    "visual_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["archetype", "description", "asset_queries"],
      "properties": {
        "archetype": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "asset_queries": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    },
    "speaker_notes": {
      "type": "string",
      "maxLength": 4000
    },
    "created_at": {
      "type": "integer",
      "minimum": 0,
      "x-runtime-managed": true
    },
    "updated_at": {
      "type": "integer",
      "minimum": 0,
      "x-runtime-managed": true
    }
  },
  "x-agent-example": {
    "section_id": "section-main",
    "role": "evidence",
    "title": "增长来自高价值客户",
    "key_message": "企业客户贡献了主要增量",
    "content": {
      "summary": "用一组核心指标解释增长结构",
      "points": ["企业收入同比增长 42%", "续约率提升至 93%"]
    },
    "visual_intent": {
      "archetype": "data-story",
      "description": "左侧结论，右侧使用两项大数字与趋势图",
      "asset_queries": []
    },
    "speaker_notes": ""
  }
}
