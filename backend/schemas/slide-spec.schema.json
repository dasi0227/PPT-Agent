{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ppt-agent.local/schemas/slide-spec.schema.json",
  "title": "PPT Slide Spec",
  "description": "One slide's semantic role, core message, planned elements, and optional layout direction.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "revision",
    "project_id",
    "slide_id",
    "section_id",
    "role",
    "title",
    "key_message",
    "elements",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "version": {
      "const": "3.0",
      "x-runtime-managed": true
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "x-runtime-managed": true
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
      "x-runtime-managed": true
    },
    "slide_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
      "x-runtime-managed": true
    },
    "section_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
      "description": "The owning outline section. Required for every slide."
    },
    "subsection_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
      "description": "Required and must belong to section_id when that section is grouped (has subsections); must be omitted when that section is direct (no subsections)."
    },
    "role": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "key_message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "elements": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "intent"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["text", "list", "metric", "quote", "table", "chart", "diagram", "code", "asset"]
          },
          "intent": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          }
        }
      }
    },
    "layout": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "created_at": {
      "type": "integer",
      "minimum": 0,
      "x-runtime-managed": true
    },
    "updated_at": {
      "type": "integer",
      "minimum": 0,
      "x-runtime-managed": true
    }
  },
  "x-agent-example": {
    "section_id": "section-key-findings",
    "role": "evidence",
    "title": "增长来自高价值客户",
    "key_message": "企业客户贡献了主要增量",
    "elements": [
      {
        "type": "metric",
        "intent": "突出企业收入同比增长 42%"
      },
      {
        "type": "chart",
        "intent": "展示企业收入和续约率的连续增长趋势"
      },
      {
        "type": "asset",
        "intent": "使用企业团队分析业务数据的写实辅助画面"
      }
    ],
    "layout": "two-column"
  }
}
