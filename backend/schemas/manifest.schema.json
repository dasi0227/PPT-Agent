{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ppt-agent.local/schemas/manifest.schema.json",
  "title": "Presentation Manifest",
  "description": "Presentation title, intent, audience, language, requirements and prohibitions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "project_id",
    "title",
    "goal",
    "audience",
    "language",
    "requirements",
    "prohibitions",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "version": {
      "const": "5.0",
      "x-runtime-managed": true
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "x-runtime-managed": true
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "audience": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "language": {
      "type": "string",
      "minLength": 2,
      "maxLength": 32
    },
    "requirements": {
      "$ref": "#/$defs/rules"
    },
    "prohibitions": {
      "$ref": "#/$defs/rules"
    },
    "created_at": {
      "type": "integer",
      "minimum": 0,
      "x-runtime-managed": true
    },
    "updated_at": {
      "type": "integer",
      "minimum": 0,
      "x-runtime-managed": true
    }
  },
  "$defs": {
    "rules": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    }
  },
  "x-agent-example": {
    "title": "季度业务复盘",
    "goal": "解释增长来源",
    "audience": "管理团队",
    "language": "zh-CN",
    "requirements": [],
    "prohibitions": []
  }
}
