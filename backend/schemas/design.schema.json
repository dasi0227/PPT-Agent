{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ppt-agent.local/schemas/design.schema.json",
  "title": "PPT Design",
  "description": "Deck-wide visual language, canvas, typography, spacing, layout rhythm, signature style, and motion policy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "revision",
    "project_id",
    "canvas",
    "palette",
    "typography",
    "spacing",
    "radius",
    "shadows",
    "layout_system",
    "signature",
    "motion",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "3.0",
      "x-runtime-managed": true
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "x-runtime-managed": true
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "x-runtime-managed": true
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "ratio"],
      "properties": {
        "width": {
          "const": 1600
        },
        "height": {
          "const": 900
        },
        "ratio": {
          "const": "16:9"
        }
      }
    },
    "palette": {
      "type": "array",
      "minItems": 2,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$"
      }
    },
    "typography": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display", "body", "utility"],
      "properties": {
        "display": {
          "$ref": "#/$defs/font"
        },
        "body": {
          "$ref": "#/$defs/font"
        },
        "utility": {
          "$ref": "#/$defs/font"
        }
      }
    },
    "spacing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit"],
      "properties": {
        "unit": {
          "type": "integer",
          "minimum": 2,
          "maximum": 24
        }
      }
    },
    "radius": {
      "type": "object",
      "additionalProperties": false,
      "required": ["card"],
      "properties": {
        "card": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        }
      }
    },
    "shadows": {
      "type": "object",
      "additionalProperties": false,
      "required": ["card"],
      "properties": {
        "card": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      }
    },
    "layout_system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grid", "rhythm", "density"],
      "properties": {
        "grid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "rhythm": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "density": {
          "type": "string",
          "enum": ["sparse", "medium", "dense"]
        }
      }
    },
    "signature": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy"],
      "properties": {
        "policy": {
          "type": "string",
          "enum": ["none", "restrained", "expressive"]
        }
      }
    },
    "created_at": {
      "type": "integer",
      "minimum": 0,
      "x-runtime-managed": true
    },
    "updated_at": {
      "type": "integer",
      "minimum": 0,
      "x-runtime-managed": true
    }
  },
  "$defs": {
    "font": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "weight"],
      "properties": {
        "family": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "weight": {
          "type": "integer",
          "minimum": 100,
          "maximum": 900,
          "multipleOf": 100
        }
      }
    }
  },
  "x-agent-example": {
    "canvas": {
      "width": 1600,
      "height": 900,
      "ratio": "16:9"
    },
    "palette": ["#111827", "#FFFFFF", "#2563EB"],
    "typography": {
      "display": {
        "family": "Inter, sans-serif",
        "weight": 700
      },
      "body": {
        "family": "Inter, sans-serif",
        "weight": 400
      },
      "utility": {
        "family": "Inter, sans-serif",
        "weight": 500
      }
    },
    "spacing": {
      "unit": 8
    },
    "radius": {
      "card": 16
    },
    "shadows": {
      "card": "0 12px 36px rgba(15,23,42,.12)"
    },
    "layout_system": {
      "grid": "12-column",
      "rhythm": "generous",
      "density": "medium"
    },
    "signature": "克制的几何强调元素",
    "motion": {
      "policy": "restrained"
    }
  }
}
