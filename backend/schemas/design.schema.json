{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ppt-agent.local/schemas/design.schema.json",
  "title": "PPT Design",
  "description": "Presentation-wide visual requirements and prohibitions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requirements",
    "prohibitions"
  ],
  "properties": {
    "requirements": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 600
      }
    },
    "prohibitions": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 600
      }
    }
  }
}
