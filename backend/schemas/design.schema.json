{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ppt-agent.local/schemas/design.schema.json",
  "title": "PPT Design",
  "description": "Deck-wide theme selection, visual direction, density, and shared chrome.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "revision",
    "project_id",
    "theme",
    "direction",
    "density",
    "chrome",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "version": {
      "const": "4.0",
      "x-runtime-managed": true
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "x-runtime-managed": true
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
      "x-runtime-managed": true
    },
    "theme": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,80}$",
      "minLength": 1,
      "maxLength": 80
    },
    "direction": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "density": {
      "type": "string",
      "enum": ["sparse", "medium", "dense"]
    },
    "chrome": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "placement", "style"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["page_number", "section_marker", "key_message", "deck_title"]
          },
          "placement": {
            "type": "string",
            "enum": [
              "top-left",
              "top-center",
              "top-right",
              "bottom-left",
              "bottom-center",
              "bottom-right",
              "left-edge",
              "right-edge"
            ]
          },
          "style": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        }
      }
    },
    "created_at": {
      "type": "integer",
      "minimum": 0,
      "x-runtime-managed": true
    },
    "updated_at": {
      "type": "integer",
      "minimum": 0,
      "x-runtime-managed": true
    }
  },
  "x-agent-example": {
    "theme": "tokyo-night",
    "direction": "偏云原生控制台感，而不是赛博朋克海报感",
    "density": "medium",
    "chrome": [
      {
        "type": "page_number",
        "placement": "bottom-right",
        "style": "tiny muted mono counter"
      },
      {
        "type": "section_marker",
        "placement": "left-edge",
        "style": "vertical thin-line label with section keyword"
      },
      {
        "type": "key_message",
        "placement": "bottom-center",
        "style": "low-contrast single-line takeaway"
      }
    ]
  }
}
