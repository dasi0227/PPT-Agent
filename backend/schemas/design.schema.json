{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ppt-agent.local/schemas/design.schema.json",
  "title": "PPT Design",
  "description": "Deck-wide visual direction, layout preferences, and shared decoration placement.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "project_id",
    "direction",
    "layout_preferences",
    "decorations",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "version": {
      "const": "5.0",
      "x-runtime-managed": true
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
      "x-runtime-managed": true
    },
    "direction": {
      "type": "string",
      "maxLength": 600
    },
    "decorations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page_number",
        "deck_title",
        "section_title",
        "key_message"
      ],
      "properties": {
        "page_number": {
          "type": "string",
          "enum": [
            "top-left",
            "top-center",
            "top-right",
            "bottom-left",
            "bottom-center",
            "bottom-right",
            "left-edge",
            "right-edge"
          ]
        },
        "section_title": {
          "type": "string",
          "enum": [
            "none",
            "top-left",
            "top-center",
            "top-right",
            "bottom-left",
            "bottom-center",
            "bottom-right",
            "left-edge",
            "right-edge"
          ]
        },
        "deck_title": {
          "type": "string",
          "enum": [
            "none",
            "top-left",
            "top-center",
            "top-right",
            "bottom-left",
            "bottom-center",
            "bottom-right",
            "left-edge",
            "right-edge"
          ]
        },
        "key_message": {
          "type": "string",
          "enum": [
            "none",
            "top-left",
            "top-center",
            "top-right",
            "bottom-left",
            "bottom-center",
            "bottom-right",
            "left-edge",
            "right-edge"
          ]
        }
      }
    },
    "created_at": {
      "type": "integer",
      "minimum": 0,
      "x-runtime-managed": true
    },
    "updated_at": {
      "type": "integer",
      "minimum": 0,
      "x-runtime-managed": true
    },
    "layout_preferences": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 600
      }
    }
  },
  "x-agent-example": {
    "direction": "以结构示意图和流程关系解释概念",
    "layout_preferences": [
      "少用卡片，优先通过留白和对齐区分内容"
    ],
    "decorations": {
      "page_number": "bottom-right",
      "section_title": "top-left",
      "deck_title": "none",
      "key_message": "none"
    }
  }
}
