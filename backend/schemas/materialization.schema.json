{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://ppt-agent.local/schemas/materialization.schema.json","title":"Slide Materialization","description":"Runtime-owned HTML body and frame proof.","type":"object","additionalProperties":false,"required":["version","artifact","source","frame","rendered_at"],"properties":{"version":{"const":"4.0","x-runtime-managed":true},"artifact":{"type":"object","additionalProperties":false,"required":["revision","hash"],"properties":{"revision":{"type":"integer","minimum":1},"hash":{"$ref":"#/$defs/hash"}}},"source":{"type":"object","additionalProperties":false,"required":["manifest_revision","outline_node_hash","spec_revision","design_revision","hash"],"properties":{"manifest_revision":{"type":"integer","minimum":1},"outline_node_hash":{"$ref":"#/$defs/hash"},"spec_revision":{"type":"integer","minimum":1},"design_revision":{"type":"integer","minimum":1},"hash":{"$ref":"#/$defs/hash"}}},"frame":{"type":"object","additionalProperties":false,"required":["context_hash"],"properties":{"context_hash":{"$ref":"#/$defs/hash"}}},"rendered_at":{"type":"integer","minimum":0}},"$defs":{"hash":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"}}}
