{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ppt-agent.local/schemas/outline.schema.json",
  "title": "PPT Outline",
  "description": "Deck-wide audience, thesis, narrative structure, sections, and stable slide order.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "revision",
    "project_id",
    "title",
    "goal",
    "audience",
    "language",
    "core_thesis",
    "narrative_arc",
    "sections",
    "slide_order",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "3.0",
      "x-runtime-managed": true
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "x-runtime-managed": true
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "x-runtime-managed": true
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "audience": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "language": {
      "type": "string",
      "minLength": 2,
      "maxLength": 32
    },
    "core_thesis": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "narrative_arc": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1600
    },
    "sections": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "number", "title", "subsections"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
          },
          "number": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "subsections": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "number", "title"],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
                },
                "number": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 24
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                }
              }
            }
          }
        }
      }
    },
    "slide_order": {
      "type": "array",
      "maxItems": 200,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
      }
    },
    "created_at": {
      "type": "integer",
      "minimum": 0,
      "x-runtime-managed": true
    },
    "updated_at": {
      "type": "integer",
      "minimum": 0,
      "x-runtime-managed": true
    }
  },
  "x-agent-example": {
    "title": "季度业务复盘",
    "goal": "解释增长来源并明确下一季度行动",
    "audience": "管理团队",
    "language": "zh-CN",
    "core_thesis": "聚焦高质量增长",
    "narrative_arc": "结论先行，再解释证据与行动",
    "sections": [
      {
        "id": "section-main",
        "number": "01",
        "title": "核心结论",
        "subsections": []
      }
    ],
    "slide_order": ["slide-01"]
  }
}
