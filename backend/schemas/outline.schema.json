{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://ppt-agent.local/schemas/outline.schema.json","title":"PPT Outline","description":"Strict two-level tree and the only slide order.","type":"object","additionalProperties":false,"required":["version","revision","project_id","sections","created_at","updated_at"],"properties":{"version":{"const":"4.0","x-runtime-managed":true},"revision":{"type":"integer","minimum":1,"x-runtime-managed":true},"project_id":{"type":"string","minLength":1,"x-runtime-managed":true},"sections":{"type":"array","maxItems":32,"items":{"$ref":"#/$defs/section"}},"created_at":{"type":"integer","minimum":0,"x-runtime-managed":true},"updated_at":{"type":"integer","minimum":0,"x-runtime-managed":true}},"$defs":{"slide":{"type":"object","additionalProperties":false,"required":["slide_id","label","role"],"properties":{"slide_id":{"type":"string","pattern":"^sli_[A-Za-z0-9_-]+$"},"label":{"type":"string","minLength":1,"maxLength":160},"role":{"type":"string","minLength":1,"maxLength":80}}},"subsection":{"type":"object","additionalProperties":false,"required":["id","title","slides"],"properties":{"id":{"type":"string","pattern":"^sub_[A-Za-z0-9_-]+$"},"title":{"type":"string","minLength":1,"maxLength":160},"slides":{"type":"array","maxItems":200,"items":{"$ref":"#/$defs/slide"}}}},"section":{"type":"object","additionalProperties":false,"required":["id","title","purpose","slides","subsections"],"properties":{"id":{"type":"string","pattern":"^sec_[A-Za-z0-9_-]+$"},"title":{"type":"string","minLength":1,"maxLength":160},"purpose":{"type":"string","minLength":1,"maxLength":400},"slides":{"type":"array","maxItems":200,"items":{"$ref":"#/$defs/slide"}},"subsections":{"type":"array","maxItems":64,"items":{"$ref":"#/$defs/subsection"}}}}},"x-agent-example":{"sections":[]}}
