{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ppt-agent.local/schemas/outline.schema.json",
  "title": "PPT Outline",
  "description": "Deck-wide goal, audience, positioning, requirements, prohibitions, section structure, and stable slide order.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "revision",
    "project_id",
    "title",
    "goal",
    "audience",
    "language",
    "requirements",
    "prohibitions",
    "sections",
    "slide_order",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "version": {
      "const": "3.0",
      "x-runtime-managed": true
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "x-runtime-managed": true
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
      "x-runtime-managed": true
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "audience": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "language": {
      "type": "string",
      "minLength": 2,
      "maxLength": 32
    },
    "positioning": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "requirements": { "$ref": "#/$defs/rule_list" },
    "prohibitions": { "$ref": "#/$defs/rule_list" },
    "sections": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "purpose", "subsections"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "subsections": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "title"],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                }
              }
            }
          }
        }
      }
    },
    "slide_order": {
      "type": "array",
      "maxItems": 200,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
      }
    },
    "created_at": {
      "type": "integer",
      "minimum": 0,
      "x-runtime-managed": true
    },
    "updated_at": {
      "type": "integer",
      "minimum": 0,
      "x-runtime-managed": true
    }
  },
  "$defs": {
    "rule_list": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    }
  },
  "x-agent-example": {
    "title": "季度业务复盘",
    "goal": "解释增长来源并明确下一季度行动",
    "audience": "管理团队",
    "language": "zh-CN",
    "positioning": "Q4 增长的关键不再是扩大线索规模，而是提高高价值客户的续约与扩展效率。",
    "requirements": [
      "说明企业客户续约趋势",
      "保持正式汇报语气",
      "控制在 12 页以内"
    ],
    "prohibitions": ["虚构未提供的数据"],
    "sections": [
      {
        "id": "section-key-findings",
        "title": "核心结论",
        "purpose": "先给出管理层需要决策的主判断",
        "subsections": []
      }
    ],
    "slide_order": ["sli_abcd23"]
  }
}
