<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dasi.ppt.agent.infrastructure.persistence.database.mapper.BehaviorSettingsMapper">
    <resultMap id="behaviorSettingsPo" type="com.dasi.ppt.agent.infrastructure.persistence.database.po.BehaviorSettingsPo">
        <id column="id" property="id"/>
        <result column="auto_rename_enabled" property="autoRenameEnabled"/>
        <result column="auto_suggest_enabled" property="autoSuggestEnabled"/>
        <result column="show_tool_failures" property="showToolFailures"/>
        <result column="require_resource_approval" property="requireResourceApproval"/>
        <result column="require_high_risk_approval" property="requireHighRiskApproval"/>
    </resultMap>

    <select id="getBehaviorSettings" resultMap="behaviorSettingsPo">
        SELECT * FROM settings_behavior WHERE id = 1
    </select>

    <update id="saveBehaviorSettings">
        UPDATE settings_behavior
        <set>
            id = id,
            <if test="autoRenameEnabled != null">auto_rename_enabled = #{autoRenameEnabled},</if>
            <if test="autoSuggestEnabled != null">auto_suggest_enabled = #{autoSuggestEnabled},</if>
            <if test="showToolFailures != null">show_tool_failures = #{showToolFailures},</if>
            <if test="requireResourceApproval != null">require_resource_approval = #{requireResourceApproval},</if>
            <if test="requireHighRiskApproval != null">require_high_risk_approval = #{requireHighRiskApproval},</if>
        </set>
        WHERE id = #{id}
    </update>
</mapper>
