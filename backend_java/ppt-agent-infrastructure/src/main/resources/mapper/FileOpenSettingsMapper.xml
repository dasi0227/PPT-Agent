<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dasi.ppt.agent.infrastructure.persistence.database.mapper.FileOpenSettingsMapper">
    <resultMap id="fileOpenSettingsPo" type="com.dasi.ppt.agent.infrastructure.persistence.database.po.FileOpenSettingsPo">
        <id column="id" property="id"/>
        <result column="default_open" property="defaultOpen"/>
        <result column="json_open" property="jsonOpen"/>
        <result column="html_open" property="htmlOpen"/>
        <result column="custom_apps" property="customApps"/>
    </resultMap>

    <select id="getFileOpenSettings" resultMap="fileOpenSettingsPo">
        SELECT * FROM settings_fileopen WHERE id = 1
    </select>

    <insert id="saveFileOpenSettings">
        INSERT INTO settings_fileopen (
            id, default_open, json_open, html_open, custom_apps
        ) VALUES (
            #{id}, #{defaultOpen}, #{jsonOpen}, #{htmlOpen}, #{customApps}
        )
        ON CONFLICT (id) DO UPDATE SET
            default_open = excluded.default_open,
            json_open = excluded.json_open,
            html_open = excluded.html_open,
            custom_apps = excluded.custom_apps
    </insert>
</mapper>
