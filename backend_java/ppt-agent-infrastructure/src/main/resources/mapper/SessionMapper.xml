<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dasi.ppt.agent.infrastructure.persistence.database.mapper.SessionMapper">
    <resultMap id="sessionPo" type="com.dasi.ppt.agent.infrastructure.persistence.database.po.SessionPo">
        <id column="id" property="id"/>
        <result column="project_id" property="projectId"/>
        <result column="revision" property="revision"/>
        <result column="title" property="title"/>
        <result column="plan" property="plan"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>
    <select id="exists" resultType="boolean">
        SELECT EXISTS (SELECT 1 FROM sessions WHERE id = #{sessionId})
    </select>

    <select id="listProjectSessionIds" resultType="string">
        SELECT id FROM sessions WHERE project_id = #{projectId}
    </select>

</mapper>
