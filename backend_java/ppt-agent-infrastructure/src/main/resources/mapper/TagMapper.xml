<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dasi.ppt.agent.infrastructure.persistence.database.mapper.TagMapper">
    <resultMap id="tagPo" type="com.dasi.ppt.agent.infrastructure.persistence.database.po.TagPo">
        <id column="id" property="id"/>
        <result column="type" property="type"/>
        <result column="name" property="name"/>
    </resultMap>

    <select id="list" resultMap="tagPo">
        SELECT id, type, name FROM tags WHERE type = #{type} ORDER BY name, id
    </select>

    <select id="listNames" resultType="string">
        SELECT name FROM tags WHERE type = #{type}
    </select>

    <insert id="insert">
        INSERT INTO tags (id, type, name) VALUES (#{id}, #{type}, #{name})
    </insert>

    <delete id="delete">
        DELETE FROM tags WHERE id = #{tagId}
    </delete>
</mapper>
