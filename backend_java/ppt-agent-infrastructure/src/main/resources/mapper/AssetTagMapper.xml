<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dasi.ppt.agent.infrastructure.persistence.mapper.AssetTagMapper">
    <resultMap id="assetTagPo" type="com.dasi.ppt.agent.infrastructure.persistence.po.AssetTagPo">
        <id column="asset_id" property="assetId"/>
        <id column="tag_id" property="tagId"/>
    </resultMap>

    <insert id="insertAssetTagLinks">
        INSERT INTO asset_tags (asset_id, tag_id) VALUES
        <foreach collection="tagIds" item="tagId" separator=",">
            (#{assetId}, #{tagId})
        </foreach>
    </insert>

    <delete id="deleteAssetTagLinksByAssetId">
        DELETE FROM asset_tags WHERE asset_id = #{assetId}
    </delete>
</mapper>
